# Safe placeholders only. All processes must use the same private data/DB.
DORMGUARD_ENV=evaluation
DORMGUARD_DATA=./data
DORMGUARD_AUTH=supabase
DORMGUARD_DATABASE_URL=
DORMGUARD_PUBLIC_URL=http://127.0.0.1:8000
DORMGUARD_HTTPS=0
SUPABASE_URL=
SUPABASE_ANON_KEY=
# Never exposed to the browser. Provision invitations through trusted Supabase admin.
SUPABASE_SERVICE_ROLE_KEY=
TELEGRAM_BOT_TOKEN=
TELEGRAM_BOT_USERNAME=
TELEGRAM_WEBHOOK_SECRET=
# Comma-separated explicit literal-IP camera CIDRs. Empty denies RTSP.
DORMGUARD_CAMERA_NETWORKS=
DORMGUARD_CAMERA_TEST=
INFERENCE_FPS=4
MAX_INFERENCE_QUEUE=4
MODEL_DEVICE=cpu
MODEL_MANIFEST=
DORMGUARD_MODEL_RIGHTS_CONFIRMED=0
DETECTION_THRESHOLD=0.7
INCIDENT_COOLDOWN_SECONDS=60
DORMGUARD_MAX_CAMERAS=4
DORMGUARD_MAX_RSS_MB=2048
DORMGUARD_WINDOW_SECONDS=5
DORMGUARD_WINDOW_STRIDE=2.5
DORMGUARD_CONFIRMATIONS=2
DORMGUARD_EVIDENCE_PRE_SECONDS=5
DORMGUARD_EVIDENCE_POST_SECONDS=5
DORMGUARD_RETENTION_DAYS=30
DORMGUARD_SESSION_SECONDS=28800
